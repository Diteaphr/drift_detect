{
  "name": "ecpf_reuse_value",
  "kind": "pipeline",
  "role": "ablation",
  "description": "ecpf_paper with AiRStream-style reuse-value fading; the 'reuse_cap10' arm of outputs/ecpf_pool_swap_0930.",
  "source": "scripts/experiment_ecpf_pool_unbounded.py CONFIGS['reuse_cap10']",
  "requires": {"river": "0.21.2"},
  "warm_start": 200,
  "seed_param": null,
  "config": {
    "model_type": "ht",
    "use_ecpf": true,
    "ecpf_signal_mode": "dual_adwin",
    "detector_delta": 0.05,
    "ecpf_swap_policy": "strict",
    "ecpf_fade_policy": "reuse_value",
    "ecpf_fade_enabled": true,
    "ecpf_max_pool_size": 10
  },
  "task_overrides": {
    "regression": {"model_type": "htr"}
  }
}
