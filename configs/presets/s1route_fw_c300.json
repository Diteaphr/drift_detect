{
  "name": "s1route_fw_c300",
  "kind": "pipeline",
  "role": "ablation",
  "description": "det3_full_dual_adwin_lw1 with routed confirmation: the pair (ADWIN or HDDM-A) that warned first confirms; cooldown 300.",
  "source": "scripts/make_routed_presets.py",
  "requires": {
    "river": "0.21.2"
  },
  "warm_start": 200,
  "seed_param": null,
  "config": {
    "model_type": "ht",
    "use_ecpf": true,
    "ecpf_signal_mode": "dual_adwin",
    "detector_delta": 0.05,
    "ecpf_swap_policy": "strict",
    "ecpf_fade_policy": "ecpf",
    "ecpf_fade_enabled": true,
    "ecpf_max_pool_size": 10,
    "detector_delta_w": 0.1,
    "ecpf_warning_signal": "error",
    "ecpf_drift_signal": "error",
    "ecpf_adwin_one_sided": false,
    "ecpf_reference_signal": true,
    "ecpf_reference_warmup": 500,
    "ecpf_leader_guard": true,
    "ecpf_detector_warning_timeout": 1000,
    "ecpf_guard_frozen_scale": 500,
    "ecpf_learn_during_warning": true,
    "ecpf_route_policy": "first_warner",
    "ecpf_route_decision_delay": 100,
    "ecpf_confirm_cooldown": 300
  },
  "task_overrides": {
    "regression": {
      "model_type": "htr"
    }
  },
  "tasks": [
    "binary",
    "multiclass"
  ]
}
