{
  "name": "det8_h3",
  "kind": "pipeline",
  "role": "ablation",
  "description": "DET8 H3: HDDM-A warning/drift zone on the leader's loss at drift confidence 3e-4 (warning 1.5e-3); otherwise det1_zone_hddm_a_lw0.",
  "source": "docs/ECPF_DET8_預註冊.md",
  "requires": {
    "river": "0.21.2"
  },
  "warm_start": 200,
  "seed_param": null,
  "config": {
    "model_type": "ht",
    "use_ecpf": true,
    "ecpf_signal_mode": "dual_adwin",
    "detector_delta": 0.05,
    "ecpf_swap_policy": "strict",
    "ecpf_fade_policy": "ecpf",
    "ecpf_fade_enabled": true,
    "ecpf_max_pool_size": 10,
    "detector_delta_w": 0.1,
    "ecpf_warning_signal": "error",
    "ecpf_drift_signal": "error",
    "ecpf_learn_during_warning": false,
    "ecpf_zone_detector": "hddm_a",
    "ecpf_detector_warning_timeout": 0,
    "ecpf_zone_drift_confidence": 0.0003
  },
  "task_overrides": {
    "regression": {
      "model_type": "htr"
    }
  },
  "tasks": [
    "binary",
    "multiclass"
  ]
}
