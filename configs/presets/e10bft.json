{
  "name": "e10bft",
  "kind": "pipeline",
  "role": "main",
  "description": "Main method E10bFT on a single Hoeffding Tree: frozen reference model + leader guard + warning timeout on the dual-ADWIN ECPF path. Used whenever an experiment does not name another system.",
  "source": "docs/實驗脈絡總覽.md, section 'how to enable'; E13/E14 validated it on ht (and hf10)",
  "requires": {"river": "0.21.2"},
  "warm_start": 200,
  "seed_param": null,
  "config": {
    "model_type": "ht",
    "use_ecpf": true,
    "ecpf_signal_mode": "dual_adwin",
    "ecpf_warning_signal": "error",
    "ecpf_drift_signal": "error",
    "ecpf_reference_signal": true,
    "ecpf_reference_warmup": 500,
    "ecpf_leader_guard": true,
    "ecpf_detector_warning_timeout": 1000,
    "ecpf_guard_frozen_scale": 500,
    "detector_delta": 0.05,
    "ecpf_learn_during_warning": false
  },
  "task_overrides": {
    "regression": {
      "model_type": "htr",
      "ecpf_normalizer_reset_on_drift": true,
      "model_kwargs": {"clip_predictions": true}
    }
  }
}
