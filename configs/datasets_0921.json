    "injected_paper_electricity": {
      "group": "injected", "task": "binary", "role": "report",
      "generator": {
        "name": "electricity", "source": "data/dataset_0921/real_dataset/binary/electricity/electricity.csv",
        "width": 2500, "n_trials": 50, "max_n": 100000, "truncate_after_shuffle": true,
        "drift_region": [0.5, 0.8], "label_skip_proba": 0.75, "seed_tag": "paper",
        "methods": ["class_prior", "label_swap", "feature_permutation", "feature_filtering"],
        "abruptness": ["abrupt", "gradual"]
      },
      "gt": "generator", "delta_max": 2500, "order": "shuffled", "truncated": false,
      "coordinates": "input", "detect_from_fraction": 0.25,
      "protocol": "injected_detection", "window": 1000,
      "comparable": true, "comparable_kinds": ["detector"],
      "comparability_note": "Generated in memory with Cerqueira et al.'s parameters (shuffle, one drift in 50-80%, width = delta_max = 2500, 50 trials, label_skip_proba 0.75). Scored like their code: input-row coordinates (dropped rows still count), alarms before 25% of the stream ignored, window [d_s, d_s + delta_max]. Only 'detector' presets follow their workflow (one HT never reset on alarm); pipeline presets adapt on alarms, so their F1 is reference only. Remaining differences: River instead of CapyMOA/MOA implementations, and our own random draws.",
      "required_metrics": ["f1", "precision", "recall", "episode_recall", "mdt", "ndt", "far"],
